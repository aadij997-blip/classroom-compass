# Classroom Compass environment. Copy to .env.local. Never commit real values.
#
# Leave the Supabase values empty to run in LOCAL mode: an isolated sample class
# plus a local trial workspace stored in .data/compass.sqlite on this computer.
# Local mode is for evaluation only. It is not set up for classroom collection
# across devices.

# --- Supabase (configured classroom mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No service-role key is required or read by this app. Do not add one here.

# Optional: where local mode stores its SQLite file (default .data/compass.sqlite)
COMPASS_SQLITE_PATH=
